rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 觀察清單：文件 id 是密碼的 SHA-256，只能讀取或寫入自己知道 id 的那一份，不能列出全部或刪除
    match /watchlists/{listId} {
      allow get: if listId.size() == 64;
      allow list, delete: if false;
      allow create, update: if listId.size() == 64
        && request.resource.data.keys().hasOnly(['tickers', 'updated'])
        && request.resource.data.tickers is list
        && request.resource.data.tickers.size() <= 20
        && request.resource.data.updated == request.time;
    }
    // 其他路徑一律關閉（如果這個 Firebase 專案還有別的 App，請把這段跟原本的規則合併）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
